# Port automatically assigned by Render/hosting provider (default: 8000)
PORT=8000

# Allowed frontend origin(s) for CORS. Can be comma-separated.
# Example: FRONTEND_URL=https://scamshield-ai.vercel.app
FRONTEND_URL=http://localhost:5173

# ---------------------------------------------------------------------------
# Nebius AI (Token Factory) — optional LLM inference
# Docs: https://docs.nebius.com/ai
#
# NEBIUS_API_KEY  : Your Nebius API key (required to enable LLM inference).
#                   When absent, the backend falls back to rule-based detection.
# NEBIUS_MODEL    : Required model ID. Set this explicitly to an available model
#                   ID shown in your Nebius Token Factory account.
# ---------------------------------------------------------------------------
# NEBIUS_API_KEY=your-nebius-api-key
# NEBIUS_MODEL=
