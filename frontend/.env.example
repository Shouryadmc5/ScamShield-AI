# For local development with Vite dev server, leave VITE_API_BASE_URL empty to use the Vite proxy (/api -> http://127.0.0.1:8000).
# For production deployment (e.g. Vercel), set this to your deployed Render backend URL.
# Example: VITE_API_BASE_URL=https://scamshield-backend.onrender.com
VITE_API_BASE_URL=

